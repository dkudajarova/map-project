# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw GIS data stays local; compact Development Log source snapshots are versioned.
/data/raw/*
!/data/raw/development-logs/
!/data/raw/development-logs/*.csv

# Cambridge gis data stays local
/cambridge-gis-data/

# Keep processed data exports in version control
!data/processed/
!data/processed/**

cambridgegis_data/

# Local data exploration notebooks
/notebooks/
